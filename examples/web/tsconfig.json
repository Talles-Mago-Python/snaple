{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@snaple/core": ["../../packages/core/src/index.ts"],
      "@snaple/three": ["../../packages/three/src/index.ts"],
      "@snaple/ifc": ["../../packages/ifc/src/index.ts"]
    }
  },
  "include": ["*.ts", "modelos/*.ts"],
  // Modelos com erros de tipo pré-existentes, não escritos nesta sessão —
  // ver AGENTS.md/erros comuns. Continuam funcionando normalmente no
  // seletor do viewer (o Vite não usa este tsconfig para servir/rodar o
  // código, só `npm run check` typecheck); só ficam fora do typecheck
  // estrito até alguém revisá-los.
  "exclude": ["modelos/expresso.ts", "modelos/setup.ts", "modelos/xadrez.ts"]
}
